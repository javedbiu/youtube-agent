# Copy this file to .env and fill in your own keys. Never share .env or commit it.

# Claude API key, from https://console.anthropic.com (used to write scripts)
ANTHROPIC_API_KEY=

# Free footage API keys (all optional: NASA and Wikimedia Commons are always searched and need no key)
PEXELS_API_KEY=        # https://www.pexels.com/api/
PIXABAY_API_KEY=       # https://pixabay.com/api/docs/

# Voice: "espeak" (free robot voice, for tests only), "elevenlabs", or "recorded"
VOICE_PROVIDER=espeak
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional background music file from the YouTube Audio Library
MUSIC_FILE=

# YouTube upload: OAuth client file downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRET=client_secret.json
